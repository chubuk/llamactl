[Unit]
Description=llama.cpp server (router mode, models from ~/models)
After=network.target
Conflicts=llama-server-proxy.service

[Service]
Type=simple
WorkingDirectory=%h/llama.cpp
ExecStart=%h/llama.cpp/build/bin/llama-server \
    --models-dir %h/models \
    --models-preset %h/models/presets.ini \
    --models-max 1 \
    --host 127.0.0.1 --port 8033 \
    --jinja

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
